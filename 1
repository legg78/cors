WITH

-- Период отчёта

date_list AS (

    SELECT '2025-01-01'::DATE AS date_start, '2025-12-31'::DATE AS date_end

),

 

-- Все субъекты (принципалы и бенефициары) из двух источников

subj_list_app AS (

    SELECT

        subj_h.subj_dp_code,

        subj_h.subj_sk,

        subj_h.inn_num AS inn,

        subj.sid AS epk_id,

        subj_orgidfn.full_name AS client_name,

        subj_org_kpp.kpp_code AS kpp

    FROM usl_tradefin_ndl_uvdo_snp.subj

    LEFT JOIN usl_tradefin_ndl_uvdo_snp.subj_h ON subj.subj_sk = subj_h.subj_sk

    LEFT JOIN usl_tradefin_ndl_uvdo_snp.subj_org_kpp ON subj.subj_sk = subj_org_kpp.subj_sk

    LEFT JOIN usl_tradefin_ndl_uvdo_snp.subj_orgidfn ON subj.subj_sk = subj_orgidfn.subj_sk

 

    UNION ALL

 

    SELECT

        subj_h.subj_dp_code,

        subj_h.subj_sk,

        subj_h.inn_num,

        subj.sid,

        subj_orgidfn.full_name,

        subj_org_kpp.kpp_code

    FROM usl_subj_org_idl_snp.subj

    LEFT JOIN usl_subj_org_idl_snp.subj_h ON subj.subj_sk = subj_h.subj_sk

    LEFT JOIN usl_subj_org_idl_snp.subj_org_kpp ON subj.subj_sk = subj_org_kpp.subj_sk

    LEFT JOIN usl_subj_org_idl_snp.subj_orgidfn ON subj.subj_sk = subj_orgidfn.subj_sk

),

 

-- Сделки, попадающие в отчёт

agr_sk_list_fin AS (

    SELECT DISTINCT

        agr.agr_sk,

        agr.agr_dp_code,

        agr.type_code,

        agr.sid,

        agr.num,

        agr_fin.docum_tran_amt,

        agr_fin.docum_tran_crncy_sk,

        agr.letter_cred_coverage_flag,

        agr.letter_cred_source_coverage_type_sk,

        agr.open_dt,

        agr.close_dt,

        -- данные аппликанта

        app.inn AS app_inn,

        app.epk_id AS app_epk_id,

        app.client_name AS app_name,

        app.kpp AS app_kpp,

        -- данные бенефициара

        ben.inn AS ben_inn,

        ben.epk_id AS ben_epk_id,

        ben.client_name AS ben_name,

        ben.kpp AS ben_kpp

    FROM usl_tradefin_ndl_uvdo_snp.agr

    INNER JOIN usl_tradefin_ndl_uvdo_snp.agr_fin

        ON agr.agr_sk = agr_fin.agr_sk AND agr_fin.end_dt = '9999-12-31'

    INNER JOIN usl_tradefin_ndl_uvdo_snp.agr_proc

        ON agr.agr_sk = agr_proc.agr_sk AND agr_proc.end_dt = '9999-12-31'

    INNER JOIN usl_tradefin_ndl_uvdo_snp.letter_cred_type lct

        ON agr.letter_cred_type_sk = lct.letter_cred_type_sk

        AND lct.sid IN ('1','2','10')

        AND agr.type_code IN ('org','org_draft')

    LEFT JOIN subj_list_app app

        ON agr_proc.letter_cred_org_buyer_subj_sk = app.subj_sk

    LEFT JOIN subj_list_app ben

        ON agr_proc.docum_tran_seller_subj_sk = ben.subj_sk

        AND ben.subj_dp_code IN ('tradefin_ndl_uvdo','subj_org_ndl_p_ucpkb')

    CROSS JOIN date_list

    LEFT JOIN usl_tradefin_ndl_uvdo_snp.letter_cred_org_plan_payment plan

        ON agr.agr_sk = plan.plan_payment_agr_sk

        AND SPLIT(plan.sid, '\\|')[0] IN ('VOZMPA4410','VOZMPA')

        AND COALESCE(plan.letter_cred_org_plan_payment_amt,0) > 0

        AND plan.letter_cred_org_plan_payment_dt >= date_list.date_start

    WHERE

        agr.sign_dt < date_list.date_end

        AND (

            agr.close_dt IS NULL

            OR plan.agr_sk IS NOT NULL

            OR (agr.close_dt > date_list.date_start AND agr.close_dt < date_list.date_end)

        )

        AND (

           agr_proc.letter_cred_org_buyer_subj_sk IN (SELECT subj_sk FROM subj_list_app)

            OR agr_proc.docum_tran_seller_subj_sk IN (SELECT subj_sk FROM subj_list_app)

        )

),

 

-- Операции: единая агрегация по сделке и валюте

ops_agg AS (

    SELECT

        optn.agr_sk,

        optn.crncy_sk,

        -- группы для расчёта A (проценты)

        SUM(CASE WHEN toptn.group_code = 'PayProc' AND optn.type_code = 'Operation'

                  AND optn.optn_dttm >= date_list.date_start

                 THEN optn.sum_opt_amt ELSE 0 END) AS sum_PayProc,

        -- группы для расчёта B (плата за отсрочку)

        SUM(CASE WHEN toptn.group_code IN ('DefPayFee','DefPayFeeGS','PayCredit','PayCredit5')

                  AND optn.type_code = 'Commission'

                  AND optn.optn_dttm >= date_list.date_start

                 THEN optn.sum_opt_amt ELSE 0 END) AS sum_DefPayFee,

        -- группы для расчёта D (отвлечение)

        SUM(CASE WHEN toptn.group_code = 'BankPay' AND optn.type_code = 'Operation'

                 THEN optn.sum_opt_amt ELSE 0 END) AS sum_BankPay,

        -- группы для расчёта F (возврат отвлечения)

        SUM(CASE WHEN toptn.group_code = 'BankReturn' AND optn.type_code = 'Operation'

                 THEN optn.sum_opt_amt ELSE 0 END) AS sum_BankReturn,

        -- группы для расчёта E (платежи, исключая ReturnCover) с фильтром >= date_start

        SUM(CASE WHEN toptn.group_code IN ('PrePay','Prepay','Pay','Expire')

                  AND optn.type_code = 'Operation'

                  AND optn.optn_dttm >= date_list.date_start

                 THEN optn.sum_opt_amt ELSE 0 END) AS sum_Pay_Expire,

        -- группы для расчёта EC (платежи, включая ReturnCover) с фильтром >= date_start

        SUM(CASE WHEN toptn.group_code IN ('PrePay','Prepay','Pay','ReturnCover')

                  AND optn.type_code = 'Operation'

                  AND optn.optn_dttm >= date_list.date_start

                 THEN optn.sum_opt_amt ELSE 0 END) AS sum_Pay_ReturnCover,

        -- группы для расчёта G (покрытие)

        SUM(CASE WHEN toptn.group_code = 'Cover' AND optn.type_code = 'Operation'

                 THEN optn.sum_opt_amt ELSE 0 END) AS sum_Cover,

        -- группы для расчёта Z (платежи до начала периода, исключая ReturnCover)

        SUM(CASE WHEN toptn.group_code IN ('PrePay','Prepay','Pay','Expire')

                  AND optn.type_code = 'Operation'

                  AND optn.optn_dttm < date_list.date_start

                 THEN optn.sum_opt_amt ELSE 0 END) AS sum_Z_Expire,

        -- группы для расчёта ZC (платежи до начала периода, включая ReturnCover)

        SUM(CASE WHEN toptn.group_code IN ('PrePay','Prepay','Pay','ReturnCover')

                  AND optn.type_code = 'Operation'

                  AND optn.optn_dttm < date_list.date_start

                 THEN optn.sum_opt_amt ELSE 0 END) AS sum_Z_ReturnCover,

        -- даты для BRPlan / BRFact

        MAX(CASE WHEN toptn.group_code IN ('Request','ReturnSchedule','DeferPayReturn')

                 THEN optn.optn_dttm END) AS max_date_plan,

        MAX(CASE WHEN toptn.group_code = 'BankReturn'

                 THEN optn.optn_dttm END) AS max_date_return,

        -- признак миграции

        MAX(CASE WHEN toptn.group_code = 'Migration' THEN 1 ELSE 0 END) AS migration_flag

    FROM agr_sk_list_fin

    INNER JOIN usl_tradefin_ndl_uvdo_snp.optn

        ON agr_sk_list_fin.agr_sk = optn.agr_sk

    LEFT JOIN usl_tradefin_ndl_uvdo_snp.toptn

        ON optn.toptn_sk = toptn.toptn_sk

    CROSS JOIN date_list

    WHERE optn.optn_dttm <= date_list.date_end

      AND SPLIT(optn.optn_sid, '\\|')[0] > 0

    GROUP BY optn.agr_sk, optn.crncy_sk

),

 

-- Курсы валют на текущую дату (для пересчёта в рубли)

rates AS (

    SELECT

        crncy.crncy_sk,

        crncy.digital_code,

        crncy.iso_code,

        r_dt.rub_rate_amt,

        r_dt.qty_rub_cnt

    FROM usl_rdm_idl_spark_snp.crncy

    LEFT JOIN usl_gmrates_idl_snp.cbr_exchange_rate r

        ON crncy.crncy_sk = r.crncy_sk

    LEFT JOIN usl_gmrates_idl_snp.cbr_exchange_rate_dt r_dt

        ON r.cbr_exchange_rate_sk = r_dt.cbr_exchange_rate_sk

        AND r_dt.point_dt = CURRENT_DATE

),

 

-- Основной запрос

SELECT DISTINCT

    C.sid                             AS `ID аккредитива в dflike`,

    C.num                             AS `(1) Номер аккредитива`,

 

    C.app_inn                         AS `ИНН Плательщика`,

    C.ben_inn                         AS `ИНН Получателя`,

    C.app_epk_id                       AS `EPK_ID Плательщика`,

    C.ben_epk_id                       AS `EPK_ID Получателя`,

    C.app_name                         AS `Наименование Плательщика`,

    C.ben_name                         AS `Наименование Получателя`,

    C.app_kpp                          AS `КПП Плательщика`,

    C.ben_kpp                          AS `КПП Получателя`,

 

    C.agr_dp_code,

    C.type_code,

    C.docum_tran_amt                   AS `(2) Сумма аккредитива (на дату открытия)`,

    crncy_agr.iso_code                 AS `(3) Валюта аккредитива`,

    C.open_dt                          AS `(4) Дата открытия`,

    C.close_dt                         AS `(5) Дата закрытия`,

    agr_cond.mat_dt                    AS `(6) Дата истечения`,

    C.letter_cred_coverage_flag         AS `Флаг покрытого аккредитива`,

    lcs.letter_cred_source_coverage_type_name AS `Тип источника покрытия`,

 

    -- (7) Остаток в валюте аккредитива

    C.docum_tran_amt

        - CASE

            WHEN C.letter_cred_coverage_flag = false

                THEN COALESCE(ops_agg_PayExp.sum_Pay_Expire, 0)      -- E

            ELSE COALESCE(ops_agg_PayRC.sum_Pay_ReturnCover, 0)     -- EC

          END

        + COALESCE(ops_agg_Bank.sum_BankPay - ops_agg_Bank.sum_BankReturn, 0) AS `(7) Остаток в валюте аккредитива`,

 

    -- (8) Остаток в рублях (аналогично, с пересчётом)

    CASE

        WHEN C.letter_cred_coverage_flag = false

            THEN C.docum_tran_amt * COALESCE(r_agr.rub_rate_amt / NULLIF(r_agr.qty_rub_cnt, 0), 1)

        ELSE COALESCE(ops_agg_Cover.sum_Cover, 0)

               * COALESCE(r_cover.rub_rate_amt / NULLIF(r_cover.qty_rub_cnt, 0), 1)

    END

    - CASE

        WHEN C.letter_cred_coverage_flag = false

            THEN COALESCE(ops_agg_PayExp.sum_Pay_Expire, 0)

                   * COALESCE(r_pay.rub_rate_amt / NULLIF(r_pay.qty_rub_cnt, 0), 1)

        ELSE COALESCE(ops_agg_PayRC.sum_Pay_ReturnCover, 0)

               * COALESCE(r_payrc.rub_rate_amt / NULLIF(r_payrc.qty_rub_cnt, 0), 1)

      END

    + COALESCE(

        (ops_agg_Bank.sum_BankPay - ops_agg_Bank.sum_BankReturn)

        * COALESCE(r_bank.rub_rate_amt / NULLIF(r_bank.qty_rub_cnt, 0), 1),

        0

      ) AS `(8) Остаток (руб.)`,

 

    -- Сумма досье на начало периода (Z и ZC)

    CASE

        WHEN C.letter_cred_coverage_flag = false

            THEN C.docum_tran_amt * COALESCE(r_agr.rub_rate_amt / NULLIF(r_agr.qty_rub_cnt, 0), 1)

        ELSE COALESCE(ops_agg_Cover.sum_Cover, 0)

               * COALESCE(r_cover.rub_rate_amt / NULLIF(r_cover.qty_rub_cnt, 0), 1)

    END

    - CASE

        WHEN C.letter_cred_coverage_flag = false

            THEN COALESCE(ops_agg_ZExp.sum_Z_Expire, 0)

                   * COALESCE(r_zexp.rub_rate_amt / NULLIF(r_zexp.qty_rub_cnt, 0), 1)

        ELSE COALESCE(ops_agg_ZRC.sum_Z_ReturnCover, 0)

               * COALESCE(r_zrc.rub_rate_amt / NULLIF(r_zrc.qty_rub_cnt, 0), 1)

      END

    + COALESCE(

        (ops_agg_Bank.sum_BankPay - ops_agg_Bank.sum_BankReturn)

        * COALESCE(r_bank.rub_rate_amt / NULLIF(r_bank.qty_rub_cnt, 0), 1),

        0

      ) AS `Сумма досье на дату начала отчета`,

 

    -- (9) Плата за отсрочку

    COALESCE(ops_agg_Fee.sum_DefPayFee, 0) AS `(9) Плата за отсрочку Банка, списанная за отчетный период`,

    crncy_fee.iso_code                  AS `(10) Валюта платы`,

 

    -- (11) Проценты

    COALESCE(ops_agg_Proc.sum_PayProc, 0) AS `(11) Выплаченные проценты на остаток покрытия`,

    crncy_proc.iso_code                  AS `(12) Валюта процентов`,

 

    CASE WHEN ops_agg_Mig.migration_flag = 1 THEN true ELSE false END AS `Признак миграции`,

 

    -- дополнительные технические поля

    agr_fin.docum_tran_amt               AS `Сумма сделки НПА на дату отчета`,

    (C.docum_tran_amt * COALESCE(r_agr.rub_rate_amt / NULLIF(r_agr.qty_rub_cnt, 0), 1)) AS `Сумма сделки НПА на дату отчета (руб.)`

 

FROM agr_sk_list_fin C

 

-- Присоединяем справочники

LEFT JOIN usl_tradefin_ndl_uvdo_snp.agr_cond

    ON C.agr_sk = agr_cond.agr_sk AND agr_cond.end_dt = '9999-12-31'

LEFT JOIN usl_tradefin_ndl_uvdo_snp.agr_fin

