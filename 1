    ON C.agr_sk = ops_agg_ZExp.agr_sk

LEFT JOIN rates r_zexp

    ON ops_agg_ZExp.crncy_sk = r_zexp.crncy_sk

 

LEFT JOIN ops_agg ops_agg_ZRC

    ON C.agr_sk = ops_agg_ZRC.agr_sk

LEFT JOIN rates r_zrc

    ON ops_agg_ZRC.crncy_sk = r_zrc.crncy_sk

 

LEFT JOIN ops_agg ops_agg_Mig

    ON C.agr_sk = ops_agg_Mig.agr_sk

 

