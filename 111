import org.apache.spark.sql.{DataFrame, SparkSession}

import org.apache.spark.sql.functions._

import org.apache.spark.sql.types._

 

object LetterOfCreditReport {

 

  def buildReport(

      spark: SparkSession,

      // таблицы из usl_tradefin_ndl_uvdo_snp

      subj: DataFrame,

      subj_h: DataFrame,

      subj_org_kpp: DataFrame,

      subj_orgidfn: DataFrame,

      agr: DataFrame,

      agr_fin: DataFrame,

      agr_proc: DataFrame,

      agr_cond: DataFrame,

      letter_cred_type: DataFrame,

      letter_cred_source_coverage_type: DataFrame,

      letter_cred_org_plan_payment: DataFrame,

      optn: DataFrame,

      toptn: DataFrame,

      // таблицы из usl_subj_org_idl_snp

      subj_idl: DataFrame,

      subj_h_idl: DataFrame,

      subj_org_kpp_idl: DataFrame,

      subj_orgidfn_idl: DataFrame,

      // таблицы курсов

      crncy: DataFrame,

      cbr_exchange_rate: DataFrame,

      cbr_exchange_rate_dt: DataFrame

  ): DataFrame = {

 

    import spark.implicits._

 

    val currentDate = lit(current_date())

 

    // ------------------------------------------------------------

    // 1. date_list

    // ------------------------------------------------------------

    val dateList = Seq(

      (java.sql.Date.valueOf("2025-01-01"), java.sql.Date.valueOf("2025-12-31"))

    ).toDF("date_start", "date_end")

 

    // ------------------------------------------------------------

    // 2. subj_list_app (объединение двух источников)

    // ------------------------------------------------------------

    val subjListApp1 = subj

      .join(subj_h, Seq("subj_sk"), "left")

      .join(subj_org_kpp, Seq("subj_sk"), "left")

      .join(subj_orgidfn, Seq("subj_sk"), "left")

      .select(

        subj_h("subj_dp_code"),

        subj_h("subj_sk"),

        subj_h("inn_num").as("inn"),

        subj("sid").as("epk_id"),

        subj_orgidfn("full_name").as("client_name"),

        subj_org_kpp("kpp_code").as("kpp")

      )

 

    val subjListApp2 = subj_idl

      .join(subj_h_idl, Seq("subj_sk"), "left")

      .join(subj_org_kpp_idl, Seq("subj_sk"), "left")

      .join(subj_orgidfn_idl, Seq("subj_sk"), "left")

      .select(

        subj_h_idl("subj_dp_code"),

        subj_h_idl("subj_sk"),

        subj_h_idl("inn_num").as("inn"),

        subj_idl("sid").as("epk_id"),

        subj_orgidfn_idl("full_name").as("client_name"),

        subj_org_kpp_idl("kpp_code").as("kpp")

      )

 

    val subjListApp = subjListApp1.union(subjListApp2).dropDuplicates("subj_sk")

 

    // ------------------------------------------------------------

    // 3. agr_sk_list_fin (основной список сделок)

    // ------------------------------------------------------------

    val planFiltered = letter_cred_org_plan_payment

      .withColumn("plan_sid_part", split($"sid", "\\|")(0))

      .filter($"plan_sid_part".isin("VOZMPA4410", "VOZMPA"))

      .filter(coalesce($"letter_cred_org_plan_payment_amt", lit(0)) > 0)

 

    val agrProcFiltered = agr_proc.filter($"end_dt" === "9999-12-31")

 

    val agrSkListFin = agr

      .join(agr_fin.filter($"end_dt" === "9999-12-31"), Seq("agr_sk"))

      .join(agrProcFiltered, Seq("agr_sk"))

      .join(letter_cred_type.filter($"sid".isin("1", "2", "10")), Seq("letter_cred_type_sk"))

      .filter($"type_code".isin("org", "org_draft"))

      // cross join date_list

      .crossJoin(dateList)

      // left join с плановыми платежами

      .join(

        planFiltered,

        expr("agr.agr_sk = plan_payment_agr_sk and letter_cred_org_plan_payment_dt >= date_start"),

        "left"

      )

      // left join с субъектами (аппликант)

      .join(

        subjListApp.as("app"),

        $"letter_cred_org_buyer_subj_sk" === $"app.subj_sk",

        "left"

      )

      // left join с субъектами (бенефициар) с фильтром по dp_code

      .join(

        subjListApp.as("ben"),

        $"docum_tran_seller_subj_sk" === $"ben.subj_sk" &&

          $"ben.subj_dp_code".isin("tradefin_ndl_uvdo", "subj_org_ndl_p_ucpkb"),

        "left"

      )

      .filter(

        $"sign_dt" < $"date_end" &&

          ($"close_dt".isNull ||

            $"plan_payment_agr_sk".isNotNull ||

            ($"close_dt" > $"date_start" && $"close_dt" < $"date_end"))

      )

      // фильтр по наличию хотя бы одного субъекта (аналог подзапроса IN)

      .filter($"app.subj_sk".isNotNull || $"ben.subj_sk".isNotNull)

      .select(

        $"agr.agr_sk",

        $"agr.agr_dp_code",

        $"agr.type_code",

        $"agr.sid",

        $"agr.num",

        $"agr_fin.docum_tran_amt",

        $"agr_fin.docum_tran_crncy_sk",

        $"agr.letter_cred_coverage_flag",

        $"agr.letter_cred_source_coverage_type_sk",

        $"agr.open_dt",

        $"agr.close_dt",

        $"app.inn".as("app_inn"),

        $"app.epk_id".as("app_epk_id"),

        $"app.client_name".as("app_name"),

        $"app.kpp".as("app_kpp"),

        $"ben.inn".as("ben_inn"),

        $"ben.epk_id".as("ben_epk_id"),

        $"ben.client_name".as("ben_name"),

        $"ben.kpp".as("ben_kpp")

      )

      .dropDuplicates("agr_sk") // как в исходном distinct

 

    // ------------------------------------------------------------

    // 4. ops_agg - агрегация операций (один проход)

    // ------------------------------------------------------------

    val optnFiltered = optn

      .withColumn("optn_sid_part", split($"optn_sid", "\\|")(0))

      .filter($"optn_sid_part".cast("long") > 0) // аналог split(...)[0] > 0

 

    val opsAgg = agrSkListFin

      .select($"agr_sk")

      .join(optnFiltered, Seq("agr_sk"))

      .join(toptn, Seq("toptn_sk"), "left")

      .crossJoin(dateList)

      .filter($"optn_dttm" <= $"date_end")

      .groupBy($"agr_sk", $"optn.crncy_sk")

      .agg(

        // A: PayProc (проценты)

        sum(

          when($"toptn.group_code" === "PayProc" && $"type_code" === "Operation" && $"optn_dttm" >= $"date_start",

            $"sum_opt_amt").otherwise(0)

        ).as("sum_PayProc"),

        // B: плата за отсрочку

        sum(

          when($"toptn.group_code".isin("DefPayFee", "DefPayFeeGS", "PayCredit", "PayCredit5") &&

            $"type_code" === "Commission" && $"optn_dttm" >= $"date_start",

            $"sum_opt_amt").otherwise(0)

        ).as("sum_DefPayFee"),

        // D: отвлечение (BankPay)

        sum(

          when($"toptn.group_code" === "BankPay" && $"type_code" === "Operation",

            $"sum_opt_amt").otherwise(0)

        ).as("sum_BankPay"),

        // F: возврат отвлечения (BankReturn)

        sum(

          when($"toptn.group_code" === "BankReturn" && $"type_code" === "Operation",

            $"sum_opt_amt").otherwise(0)

        ).as("sum_BankReturn"),

        // E: платежи (PrePay, Prepay, Pay, Expire) с датой >= date_start

        sum(

          when($"toptn.group_code".isin("PrePay", "Prepay", "Pay", "Expire") &&

            $"type_code" === "Operation" && $"optn_dttm" >= $"date_start",

            $"sum_opt_amt").otherwise(0)

        ).as("sum_Pay_Expire"),

        // EC: платежи (PrePay, Prepay, Pay, ReturnCover) с датой >= date_start

        sum(

          when($"toptn.group_code".isin("PrePay", "Prepay", "Pay", "ReturnCover") &&

            $"type_code" === "Operation" && $"optn_dttm" >= $"date_start",

            $"sum_opt_amt").otherwise(0)

        ).as("sum_Pay_ReturnCover"),

        // G: покрытие (Cover)

        sum(

          when($"toptn.group_code" === "Cover" && $"type_code" === "Operation",

            $"sum_opt_amt").otherwise(0)

        ).as("sum_Cover"),

        // Z: платежи до начала периода (PrePay, Prepay, Pay, Expire)

        sum(

          when($"toptn.group_code".isin("PrePay", "Prepay", "Pay", "Expire") &&

            $"type_code" === "Operation" && $"optn_dttm" < $"date_start",

            $"sum_opt_amt").otherwise(0)

        ).as("sum_Z_Expire"),

        // ZC: платежи до начала периода (PrePay, Prepay, Pay, ReturnCover)

        sum(

          when($"toptn.group_code".isin("PrePay", "Prepay", "Pay", "ReturnCover") &&

            $"type_code" === "Operation" && $"optn_dttm" < $"date_start",

            $"sum_opt_amt").otherwise(0)

        ).as("sum_Z_ReturnCover"),

        // максимальные даты для BRPlan и BRFact

        max(

          when($"toptn.group_code".isin("Request", "ReturnSchedule", "DeferPayReturn"),

            $"optn_dttm")

        ).as("max_date_plan"),

        max(

          when($"toptn.group_code" === "BankReturn",

            $"optn_dttm")

        ).as("max_date_return"),

        // признак миграции

        max(

          when($"toptn.group_code" === "Migration", lit(1)).otherwise(0)

        ).as("migration_flag")

      )

 

    // ------------------------------------------------------------

    // 5. rates - курсы валют на текущую дату

    // ------------------------------------------------------------

    val rates = crncy

      .join(cbr_exchange_rate, Seq("crncy_sk"), "left")

      .join(

        cbr_exchange_rate_dt.filter($"point_dt" === currentDate),

        Seq("cbr_exchange_rate_sk"),

        "left"

      )

      .select(

        $"crncy_sk",

        $"digital_code",

        $"iso_code",

        coalesce($"rub_rate_amt", lit(1.0)).as("rub_rate_amt"),

        coalesce($"qty_rub_cnt", lit(1)).as("qty_rub_cnt")

      )

 

    // ------------------------------------------------------------

    // 6. Финальный SELECT

    // ------------------------------------------------------------

    val result = agrSkListFin

      // соединяем с agr_cond

      .join(

        agr_cond.filter($"end_dt" === "9999-12-31").select($"agr_sk", $"mat_dt"),

        Seq("agr_sk"),

        "left"

      )

      // тип источника покрытия

      .join(

        letter_cred_source_coverage_type.select(

          $"letter_cred_source_coverage_type_sk",

          $"letter_cred_source_coverage_type_name"

        ),

        Seq("letter_cred_source_coverage_type_sk"),

        "left"

      )

      // курс валюты сделки

      .join(rates.as("r_agr"), $"docum_tran_crncy_sk" === $"r_agr.crncy_sk", "left")

      .join(crncy.as("crncy_agr"), $"docum_tran_crncy_sk" === $"crncy_agr.crncy_sk", "left")

 

      // присоединяем агрегированные операции для разных групп

      .join(opsAgg.as("ops_proc"), Seq("agr_sk"), "left")

      .join(rates.as("r_proc"), $"ops_proc.crncy_sk" === $"r_proc.crncy_sk", "left")

      .join(crncy.as("crncy_proc"), $"ops_proc.crncy_sk" === $"crncy_proc.crncy_sk", "left")

 

      .join(opsAgg.as("ops_fee"), Seq("agr_sk"), "left")

      .join(rates.as("r_fee"), $"ops_fee.crncy_sk" === $"r_fee.crncy_sk", "left")

      .join(crncy.as("crncy_fee"), $"ops_fee.crncy_sk" === $"crncy_fee.crncy_sk", "left")

 

      .join(opsAgg.as("ops_bank"), Seq("agr_sk"), "left")

      .join(rates.as("r_bank"), $"ops_bank.crncy_sk" === $"r_bank.crncy_sk", "left")

 

      .join(opsAgg.as("ops_pay_exp"), Seq("agr_sk"), "left")

      .join(rates.as("r_pay"), $"ops_pay_exp.crncy_sk" === $"r_pay.crncy_sk", "left")

 

      .join(opsAgg.as("ops_pay_rc"), Seq("agr_sk"), "left")

      .join(rates.as("r_payrc"), $"ops_pay_rc.crncy_sk" === $"r_payrc.crncy_sk", "left")

 

      .join(opsAgg.as("ops_cover"), Seq("agr_sk"), "left")

      .join(rates.as("r_cover"), $"ops_cover.crncy_sk" === $"r_cover.crncy_sk", "left")

 

      .join(opsAgg.as("ops_z_exp"), Seq("agr_sk"), "left")

      .join(rates.as("r_zexp"), $"ops_z_exp.crncy_sk" === $"r_zexp.crncy_sk", "left")

 

      .join(opsAgg.as("ops_z_rc"), Seq("agr_sk"), "left")

      .join(rates.as("r_zrc"), $"ops_z_rc.crncy_sk" === $"r_zrc.crncy_sk", "left")

 

      .join(opsAgg.as("ops_mig"), Seq("agr_sk"), "left")

 

      // вычисляем итоговые поля

      .select(

        // ID и номер

        $"sid".as("ID аккредитива в dflike"),

        $"num".as("(1) Номер аккредитива"),

 

        // субъекты

        $"app_inn".as("ИНН Плательщика"),

        $"ben_inn".as("ИНН Получателя"),

        $"app_epk_id".as("EPK_ID Плательщика"),

        $"ben_epk_id".as("EPK_ID Получателя"),

        $"app_name".as("Наименование Плательщика"),

        $"ben_name".as("Наименование Получателя"),

        $"app_kpp".as("КПП Плательщика"),

        $"ben_kpp".as("КПП Получателя"),

 

        // поля сделки

        $"agr_dp_code",

        $"type_code",

        $"docum_tran_amt".as("(2) Сумма аккредитива (на дату открытия)"),

        $"crncy_agr.iso_code".as("(3) Валюта аккредитива"),

        $"open_dt".as("(4) Дата открытия"),

        $"close_dt".as("(5) Дата закрытия"),

        $"mat_dt".as("(6) Дата истечения"),

        $"letter_cred_coverage_flag".as("Флаг покрытого аккредитива"),

        $"letter_cred_source_coverage_type_name".as("Тип источника покрытия"),

 

        // (7) Остаток в валюте аккредитива

        (

          $"docum_tran_amt" -

            when($"letter_cred_coverage_flag" === false, coalesce($"ops_pay_exp.sum_Pay_Expire", lit(0)))

              .otherwise(coalesce($"ops_pay_rc.sum_Pay_ReturnCover", lit(0))) +

            (coalesce($"ops_bank.sum_BankPay", lit(0)) - coalesce($"ops_bank.sum_BankReturn", lit(0)))

        ).as("(7) Остаток в валюте аккредитива"),

 

        // (8) Остаток в рублях

        (

          when($"letter_cred_coverage_flag" === false,

            $"docum_tran_amt" * $"r_agr.rub_rate_amt" / $"r_agr.qty_rub_cnt")

            .otherwise(coalesce($"ops_cover.sum_Cover", lit(0)) *

              $"r_cover.rub_rate_amt" / $"r_cover.qty_rub_cnt") -

            when($"letter_cred_coverage_flag" === false,

              coalesce($"ops_pay_exp.sum_Pay_Expire", lit(0)) * $"r_pay.rub_rate_amt" / $"r_pay.qty_rub_cnt")

              .otherwise(coalesce($"ops_pay_rc.sum_Pay_ReturnCover", lit(0)) *

                $"r_payrc.rub_rate_amt" / $"r_payrc.qty_rub_cnt") +

            (coalesce($"ops_bank.sum_BankPay", lit(0)) - coalesce($"ops_bank.sum_BankReturn", lit(0))) *

              $"r_bank.rub_rate_amt" / $"r_bank.qty_rub_cnt"

        ).as("(8) Остаток (руб.)"),

 

        // Сумма досье на начало периода

        (

          when($"letter_cred_coverage_flag" === false,

            $"docum_tran_amt" * $"r_agr.rub_rate_amt" / $"r_agr.qty_rub_cnt")

            .otherwise(coalesce($"ops_cover.sum_Cover", lit(0)) *

              $"r_cover.rub_rate_amt" / $"r_cover.qty_rub_cnt") -

            when($"letter_cred_coverage_flag" === false,

              coalesce($"ops_z_exp.sum_Z_Expire", lit(0)) * $"r_zexp.rub_rate_amt" / $"r_zexp.qty_rub_cnt")

              .otherwise(coalesce($"ops_z_rc.sum_Z_ReturnCover", lit(0)) *

                $"r_zrc.rub_rate_amt" / $"r_zrc.qty_rub_cnt") +

            (coalesce($"ops_bank.sum_BankPay", lit(0)) - coalesce($"ops_bank.sum_BankReturn", lit(0))) *

              $"r_bank.rub_rate_amt" / $"r_bank.qty_rub_cnt"

        ).as("Сумма досье на дату начала отчета"),

 

        // (9) Плата за отсрочку

        coalesce($"ops_fee.sum_DefPayFee", lit(0)).as("(9) Плата за отсрочку Банка, списанная за отчетный период"),

        $"crncy_fee.iso_code".as("(10) Валюта платы"),

 

        // (11) Проценты

        coalesce($"ops_proc.sum_PayProc", lit(0)).as("(11) Выплаченные проценты на остаток покрытия"),

        $"crncy_proc.iso_code".as("(12) Валюта процентов"),

 

        // Признак миграции

        when($"ops_mig.migration_flag" === 1, lit(true)).otherwise(lit(false)).as("Признак миграции"),

 

        // Дополнительные поля

        $"docum_tran_amt".as("Сумма сделки НПА на дату отчета"),

        ($"docum_tran_amt" * $"r_agr.rub_rate_amt" / $"r_agr.qty_rub_cnt").as("Сумма сделки НПА на дату отчета (руб.)"),

        coalesce($"ops_cover.sum_Cover", lit(0)).as("Сумма сделки ПА на дату отчета"),

        (coalesce($"ops_bank.sum_BankPay", lit(0)) - coalesce($"ops_bank.sum_BankReturn", lit(0))).as("Невозмещенное отвлечение в валюте сделки"),

        ((coalesce($"ops_bank.sum_BankPay", lit(0)) - coalesce($"ops_bank.sum_BankReturn", lit(0))) *

          $"r_bank.rub_rate_amt" / $"r_bank.qty_rub_cnt").as("Невозмещенное отвлечение в рублях")

      )

      .distinct() // как в исходном distinct

 

    result

  }

}

 

 

 
